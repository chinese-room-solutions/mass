{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "MASS (Web UI)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/mass",
            "cwd": "${workspaceFolder}",
            "buildFlags": "-tags=cublas",
            "console": "integratedTerminal",
            "env": {
                "CGO_ENABLED": "1",
                "C_INCLUDE_PATH": "D:/workspace/llama-go",
                "LIBRARY_PATH": "D:/workspace/llama-go",
                "CGO_LDFLAGS": "-LD:/workspace/llama-go",
                "PATH": "${workspaceFolder}\\bin;C:\\msys64\\mingw64\\bin;${env:PATH}"
            }
        },
        {
            "name": "Attach to Plugin",
            "type": "go",
            "request": "attach",
            "mode": "remote",
            "port": 2345,
            "host": "127.0.0.1"
        }
    ]
}
