package templates

import "fmt"
import "strings"
import "github.com/chinese-room-solutions/mass/internal/config"
import "github.com/chinese-room-solutions/mass/internal/scheduler"

templ Shell(data DashboardData) {
	<div
		data-signals={ dashboardSignals(data) }
		data-init="@get('/api/events')"
		class="min-h-screen"
	>
		<!-- Header -->
		<header class="sticky top-0 z-20 bg-neutral-900 border-b border-neutral-800">
			<div class="px-4 py-2 flex items-center gap-3">
				<img data-attr:src="$theme === 'dark' ? '/public/MASS-Dark.png' : '/public/MASS-Light.png'" alt="MASS" style="height:1.25rem"/>
				<div class="ml-auto flex items-center gap-1">
					<sl-tooltip content="Toggle light/dark theme">
						<sl-icon-button
							data-attr:name="$theme === 'dark' ? 'sun' : 'moon-stars'"
							data-on:click="@post('/api/settings/theme')"
							style="font-size:1.1rem"
						></sl-icon-button>
					</sl-tooltip>
				</div>
			</div>
			<!-- Tab nav -->
			<div class="px-4 flex gap-4 border-t border-neutral-800">
				<button
					class="px-4 py-2 text-sm font-medium border-b-2 border-transparent hover:text-white transition-colors"
					data-attr:class="$activeTab === 'modules' ? 'border-blue-500 text-white' : 'text-neutral-400 border-transparent hover:text-white'"
					data-on:click="$activeTab = 'modules'; $authTokenEdited = false; $authToken = $authTokenSet ? '\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022' : ''; var _i=document.getElementById('auth-token-input');if(_i)_i.type='password';var _e=document.getElementById('auth-token-eye');if(_e)_e.name='eye'"
					data-tab-name="modules"
				>Modules</button>
				<button
					class="px-4 py-2 text-sm font-medium border-b-2 transition-colors"
					data-attr:class="$activeTab === 'models' ? 'border-blue-500 text-white' : 'text-neutral-400 border-transparent hover:text-white'"
					data-on:click="$activeTab = 'models'; $authTokenEdited = false; $authToken = $authTokenSet ? '\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022' : ''; var _i=document.getElementById('auth-token-input');if(_i)_i.type='password';var _e=document.getElementById('auth-token-eye');if(_e)_e.name='eye'"
					data-tab-name="models"
				>Models</button>
				<button
					class="px-4 py-2 text-sm font-medium border-b-2 transition-colors"
					data-attr:class="$activeTab === 'scheduler' ? 'border-blue-500 text-white' : 'text-neutral-400 border-transparent hover:text-white'"
					data-on:click="$activeTab = 'scheduler'; $authTokenEdited = false; $authToken = $authTokenSet ? '\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022' : ''; var _i=document.getElementById('auth-token-input');if(_i)_i.type='password';var _e=document.getElementById('auth-token-eye');if(_e)_e.name='eye'; @get('/api/scheduler')"
					data-tab-name="scheduler"
				>Scheduler</button>
				<button
					class="px-4 py-2 text-sm font-medium border-b-2 transition-colors"
					data-attr:class="$activeTab === 'agents' ? 'border-blue-500 text-white' : 'text-neutral-400 border-transparent hover:text-white'"
					data-on:click="$activeTab = 'agents'"
					data-tab-name="agents"
				>Agents</button>
				<button
					class="px-4 py-2 text-sm font-medium border-b-2 transition-colors"
					data-attr:class="$activeTab === 'settings' ? 'border-blue-500 text-white' : 'text-neutral-400 border-transparent hover:text-white'"
					data-on:click="$activeTab = 'settings'; $authTokenEdited = false; $authToken = $authTokenSet ? '\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022' : ''; var _i=document.getElementById('auth-token-input');if(_i)_i.type='password';var _e=document.getElementById('auth-token-eye');if(_e)_e.name='eye'"
					data-tab-name="settings"
				>Settings</button>
			</div>
		</header>

		<!-- Modules tab -->
		<div data-show="$activeTab === 'modules'" class="flex" style="height: calc(100vh - 88px);">

			<!-- Left panel (resizable) -->
			<div
				id="mass-left-panel"
				class="flex flex-col bg-neutral-900 overflow-x-hidden flex-shrink-0"
				style="width:22%;min-width:270px"
			>
				<!-- Search + collapse toggle -->
				<div class="flex items-center gap-2 px-2 py-2 border-b border-neutral-800 flex-shrink-0 justify-end">
					<sl-input
						data-show="!$sidebarCollapsed"
						size="small"
						clearable

						placeholder="Search modules..."
						value=""
						data-bind="moduleSearch"
						data-on:sl-clear="$moduleSearch=''"
						class="flex-1"
						style="min-width:0"
					>
						<sl-icon slot="prefix" name="search"></sl-icon>
					</sl-input>
					<sl-tooltip data-attr:content="$sidebarCollapsed ? 'Expand panel' : 'Collapse panel'">
						<sl-icon-button
							id="mass-collapse-btn"
							data-attr:name="$sidebarCollapsed ? 'layout-sidebar-reverse' : 'layout-sidebar'"
							data-on:click="$sidebarCollapsed = !$sidebarCollapsed"
							style="font-size:1.1rem;flex-shrink:0"
						></sl-icon-button>
					</sl-tooltip>
				</div>

				<!-- Module list -->
				<div class="flex-1 overflow-y-auto py-1" id="module-list">
					@moduleListItems(data.Modules, data.ActiveModule)
				</div>

				<!-- Install New Module -->
				<div class="p-2 border-t border-neutral-800 flex-shrink-0">
					<sl-button
						data-show="!$sidebarCollapsed"
						size="small"
						variant="default"
						class="w-full"
						data-on:click="$addModuleOpen = true"
					>
						<sl-icon slot="prefix" name="plus-lg"></sl-icon>
						Install New Module
					</sl-button>
					<sl-tooltip data-show="$sidebarCollapsed" content="Install new module">
						<sl-icon-button
							name="plus-lg"
							data-on:click="$addModuleOpen = true"
							style="font-size:1.1rem"
						></sl-icon-button>
					</sl-tooltip>
				</div>
			</div>

			<!-- Resize handle: always in DOM, width controlled by JS -->
			<div
				id="mass-resize-handle"
				class="mass-resize-handle"
			>
				<div class="mass-resize-bar" id="mass-resize-bar"></div>
			</div>

			<!-- Main content panel -->
			<main class="flex-1 overflow-hidden relative" id="module-content-wrapper">
				<!-- Hidden deselect trigger: clicked by JS when user clicks empty space -->
				<button
					id="mass-deselect-trigger"
					style="display:none"
					data-on:click="@get('/api/modules/deselect')"
				></button>

				<div id="module-content" data-show="!$activeModule || $moduleView === 'logs'">
					@welcomeState(len(data.Modules) == 0)
				</div>

				<!-- Module UI iframe: shown when a module with UI is selected -->
				<iframe
					id="module-iframe"
					data-show="$activeModule && $moduleView !== 'logs'"
					data-attr:src="$activeModule ? '/modules/' + $activeModule + '/?theme=' + $theme : ''"
					style="width:100%;height:100%;border:none"
				></iframe>
			</main>
		</div>

		<!-- Models tab -->
		<div data-show="$activeTab === 'models'" style="height: calc(100vh - 88px);">
			@modelsTab()
		</div>

		<!-- Hidden refresh trigger for models list (clicked by JS after download completes) -->
		<button
			id="mass-models-refresh-btn"
			style="display:none"
			data-on:click="@get('/api/models')"
		></button>

		<!-- Scheduler tab -->
		<div data-show="$activeTab === 'scheduler'" style="height: calc(100vh - 88px);">
			@schedulerTab()
		</div>

		<!-- Agents tab -->
		<div data-show="$activeTab === 'agents'" style="height: calc(100vh - 88px);">
			<div style="display:flex;justify-content:center;height:100%">
			<div style="display:flex;flex-direction:column;height:100%;min-width:0;width:100%;max-width:44rem">
				<!-- Header -->
				<div style="padding:0.75rem 1.5rem 0">
					<div class="flex items-center justify-center gap-2 text-sm font-semibold text-white">
						<sl-icon name="pc-display-horizontal"></sl-icon>
						<span>Agents</span>
					</div>
					<div class="mt-2">
						<sl-input
							id="agents-filter-input"
							size="small"
							clearable
							placeholder="Filter agents..."
						>
							<sl-icon slot="prefix" name="search"></sl-icon>
						</sl-input>
					</div>
				</div>
				<!-- Agent list (scrollable) -->
				<div style="flex:1; overflow-y:auto; padding:0.75rem 1.5rem">
					@templ.Raw(data.AgentsHTML)
				</div>
				<!-- Anchored bottom bar -->
				<div style="padding:0.75rem 1.5rem; border-top:1px solid rgb(64 64 64); flex-shrink:0; text-align:center">
					<sl-button
						variant="default"
						size="small"
						style="min-width:16rem"
						id="bench-all-agents-btn"
						data-on:click="@post('/api/agents/benchmark?agentIds=' + window.__visibleAgentIds())"
					>
						<sl-icon slot="prefix" name="speedometer2"></sl-icon>
						<span id="bench-all-agents-label">Benchmark All</span>
					</sl-button>
				</div>
			</div>
			</div>
		</div>

		<!-- Settings tab -->
		<div data-show="$activeTab === 'settings'" style="height: calc(100vh - 88px);" class="flex">
			<!-- Left: settings form -->
			<div id="settings-left-panel" class="overflow-auto flex-shrink-0" style="width:40%;min-width:480px">
				@settingsPanel(data.ConfigDir, data.LogsDir, data.DataDir)
			</div>

			<!-- Resize handle -->
			<div
				id="settings-resize-handle"
				class="mass-resize-handle"
			>
				<div class="mass-resize-bar" id="settings-resize-bar"></div>
			</div>

			<!-- Right: system logs -->
			<div class="flex-1 overflow-hidden flex flex-col p-6">
				<div class="flex items-center gap-2 text-sm font-semibold mb-3 flex-shrink-0" style="color:var(--mass-text)">
					<sl-icon name="terminal"></sl-icon>
					<span>System Logs</span>
				</div>
				<div
					id="syslog-entries"
					class="font-mono text-xs rounded-lg p-4 flex-1 overflow-y-auto space-y-px"
					style="background:var(--mass-bg-panel);border:1px solid var(--mass-border)"
				>
					<p id="syslog-placeholder" style="color:var(--mass-text-muted)">Waiting for system log output...</p>
				</div>
			</div>
		</div>

		<!-- Confirm Uninstall Dialog -->
		<sl-dialog
			id="mass-confirm-uninstall-dialog"
			label="Uninstall Module"
			data-attr:open="$confirmOpen"
			data-on:sl-hide="$confirmOpen = false"
		>
			<p class="text-sm text-neutral-300">This will permanently delete the module binary, config, and all models in its data directory. This cannot be undone.</p>
			<div slot="footer" class="flex gap-2 justify-end">
				<sl-button size="small" data-on:click="$confirmOpen = false">Cancel</sl-button>
				<sl-button
					variant="danger"
					size="small"
					data-on:click="@delete('/api/modules/' + $confirmUninstall); $confirmOpen = false"
				>Uninstall</sl-button>
			</div>
		</sl-dialog>

		<!-- Add Module Dialog -->
		@addModuleDialog()


		<!-- Persistent file browser dialog (used by module UIs via window.__massBrowse) -->
		<sl-dialog id="mass-file-browser" label="Browse Files" style="--width: 640px; --body-spacing: var(--sl-spacing-small) var(--sl-spacing-large); --footer-spacing: 0;">
			<div id="mass-fb-path" class="flex items-center gap-1 flex-wrap text-xs mb-2 min-h-[24px]"></div>
			<div id="mass-fb-entries" class="max-h-[420px] overflow-y-auto space-y-0.5 pb-2 border-b border-neutral-700"></div>
			<sl-button slot="footer" size="small" variant="default" onclick="document.getElementById('mass-file-browser').hide()">Cancel</sl-button>
			<sl-button slot="footer" size="small" variant="primary" id="mass-fb-select" disabled>Select</sl-button>
		</sl-dialog>

		<!-- Persistent HF search dialog (used by module UIs) -->
		<sl-dialog id="mass-hf-dialog" label="Find on HuggingFace" style="--width: 520px;">
			<div id="mass-hf-inner"></div>
		</sl-dialog>

		<!-- Model selection dialog (used by module config UIs) -->
		<sl-dialog id="mass-model-select-dialog" label="Select Model" style="--width: 540px; --body-spacing: 0.25rem 0.75rem;">
			<div id="mass-model-select-inner">
				<div class="text-center py-8">
					<sl-spinner style="font-size:1.5rem;--track-width:3px"></sl-spinner>
				</div>
			</div>
		</sl-dialog>

		@templ.Raw(fileBrowserScript)
		@templ.Raw(shellScripts)
		@templ.Raw(settingsAutoSaveScript)
	</div>
}

templ moduleListItems(modules []ModuleViewData, activeModule string) {
	for _, p := range modules {
		<div
			class="module-row flex items-center gap-2 px-3 py-1.5 rounded-lg mx-2 cursor-pointer group"
			data-attr:class={ fmt.Sprintf("'module-row flex items-center py-1.5 cursor-pointer group ' + ($sidebarCollapsed ? 'justify-center mx-1 px-0 rounded-full' : 'gap-2 px-3 rounded-lg mx-2') + ' ' + ($activeModule === '%s' ? 'mass-row-active' : 'mass-row-hover')", p.Name) }
			data-show={ fmt.Sprintf("!$moduleSearch || '%s'.includes($moduleSearch.toLowerCase())", strings.ToLower(p.Name)) }
			data-module-name={ p.Name }
			data-on:click={ fmt.Sprintf("if(!event.target.closest('sl-icon-button,sl-switch,sl-dropdown,sl-menu')){$activeModule='%s'; $moduleView='ui'}", p.Name) }
		>
			<!-- Avatar initial/icon + status dot (always visible) -->
			<div class="relative flex-shrink-0">
				if p.HasIcon {
					<img
						src={ fmt.Sprintf("/api/modules/%s/icon", p.Name) }
						alt={ p.Name }
						class="w-8 h-8 rounded-full object-cover"
						data-on:click={ fmt.Sprintf("$activeModule='%s'; $moduleView='ui'", p.Name) }
					/>
				} else {
					<div
						class="w-8 h-8 rounded-full bg-neutral-700 flex items-center justify-center text-xs font-bold uppercase select-none"
						data-on:click={ fmt.Sprintf("$activeModule='%s'; $moduleView='ui'", p.Name) }
					>{ initial(p.Name) }</div>
				}
				<span
					id={ fmt.Sprintf("sidebar-dot-%s", p.Name) }
					class={ statusDotClass(p.State, p.LaunchMode) + " absolute -bottom-0.5 -right-0.5 border-2 border-neutral-900" }
				></span>
			</div>

			<!-- Expanded content (hidden when collapsed) -->
			<div class="flex items-center gap-1 flex-1 min-w-0" data-show="!$sidebarCollapsed">
				<!-- Name + version (clickable) -->
				<button
					class="text-sm font-medium truncate flex-1 text-left"
					data-on:click={ fmt.Sprintf("$activeModule='%s'; $moduleView='ui'", p.Name) }
				>
					{ p.Name }
					if p.Version != "" {
						<span class="text-neutral-500 font-normal ml-1">{ p.Version }</span>
					}
				</button>

				<!-- Action controls (all on one row) -->
				<div class="flex items-center gap-0.5 flex-shrink-0">
					<!-- Secondary icons (visible on hover) -->
					<div class="mass-sidebar-secondary flex items-center gap-0.5">
						@launchModeDropdown(p.Name, p.LaunchMode)
						<!-- Auto-start toggle -->
						<sl-tooltip content="Auto-start on boot">
							if p.AutoStart {
								<sl-icon-button
									name="lightning"
									class="mass-sidebar-icon"
									style="opacity:1;color:var(--sl-color-warning-400)"
									data-on:click={ fmt.Sprintf("@post('/api/modules/%s/auto-start')", p.Name) }
								></sl-icon-button>
							} else {
								<sl-icon-button
									name="lightning"
									class="mass-sidebar-icon"
									data-on:click={ fmt.Sprintf("@post('/api/modules/%s/auto-start')", p.Name) }
								></sl-icon-button>
							}
						</sl-tooltip>
						<!-- Reattach (dev mode only) -->
						<div data-show="$devMode">
							<sl-tooltip content="Reattach to running process">
								if p.Debug {
									<sl-icon-button
										name="plugin"
										class="mass-sidebar-icon"
										style="opacity:1;color:var(--sl-color-warning-400)"
										data-on:click={ fmt.Sprintf("@post('/api/modules/%s/debug')", p.Name) }
									></sl-icon-button>
								} else {
									<sl-icon-button
										name="plugin"
										class="mass-sidebar-icon"
										data-on:click={ fmt.Sprintf("@post('/api/modules/%s/debug')", p.Name) }
									></sl-icon-button>
								}
							</sl-tooltip>
						</div>
						<!-- Logs -->
						<sl-tooltip content="View live logs">
							<sl-icon-button
								name="terminal"
								class="mass-sidebar-icon"
								data-on:click={ fmt.Sprintf("$activeModule='%s'; $moduleView='logs'; @get('/api/modules/%s/ui/logs')", p.Name, p.Name) }
							></sl-icon-button>
						</sl-tooltip>
						<!-- Uninstall -->
						<sl-tooltip content="Uninstall (removes all files)">
							<sl-icon-button
								name="trash3"
								class="mass-sidebar-icon"
								style="opacity:1;color:var(--sl-color-danger-400)"
								data-on:click={ fmt.Sprintf("$confirmUninstall='%s'; $confirmOpen=true", p.Name) }
							></sl-icon-button>
						</sl-tooltip>
					</div>
					<!-- Start/Stop (patched by SSE) -->
					<span id={ fmt.Sprintf("module-actions-%s", p.Name) }>
						@moduleActionIcons(p.Name, p.State)
					</span>
				</div>
			</div>
		</div>
	}
}

templ moduleActionIcons(name string, state scheduler.ModuleState) {
	switch state {
		case scheduler.StateStopped, scheduler.StateError:
			<sl-tooltip content="Start module">
				<sl-icon-button
					name="play-fill"
					class="mass-sidebar-icon"
					style="opacity:1;color:var(--sl-color-success-400)"
					data-on:click={ fmt.Sprintf("@post('/api/modules/%s/start')", name) }
				></sl-icon-button>
			</sl-tooltip>
		case scheduler.StateRunning:
			<sl-tooltip content="Stop module">
				<sl-icon-button
					name="stop-fill"
					class="mass-sidebar-icon"
					style="opacity:1;color:var(--sl-color-danger-400)"
					data-on:click={ fmt.Sprintf("@post('/api/modules/%s/stop')", name) }
				></sl-icon-button>
			</sl-tooltip>
		case scheduler.StateStarting, scheduler.StateStopping:
			<sl-spinner style="font-size:0.8rem;--track-width:2px"></sl-spinner>
	}
}

templ launchModeDropdown(moduleName string, current config.LaunchMode) {
	<div id={ fmt.Sprintf("launch-mode-%s", moduleName) }>
		<sl-tooltip content={ launchModeTooltip(current) }>
			<sl-dropdown>
				<sl-icon-button
					slot="trigger"
					name={ launchModeIcon(current) }
					class="mass-sidebar-icon"
					style={ launchModeIconColor(current) }
				></sl-icon-button>
			<sl-menu>
				@launchModeMenuItem(moduleName, "on_demand", "activity", "On Demand", current)
				@launchModeMenuItem(moduleName, "manual", "hand-index", "Manual", current)
			</sl-menu>
		</sl-dropdown>
		</sl-tooltip>
	</div>
}

templ launchModeMenuItem(moduleName, mode, icon, label string, current config.LaunchMode) {
	<sl-menu-item
		value={ mode }
		data-on:click={ fmt.Sprintf("@post('/api/modules/%s/launch-mode?mode=%s')", moduleName, mode) }
	>
		<sl-icon slot="prefix" name={ icon } style="font-size:0.9rem"></sl-icon>
		{ label }
		if string(current) == mode {
			<sl-icon slot="suffix" name="check-lg" style="font-size:0.8rem"></sl-icon>
		}
	</sl-menu-item>
}

templ settingsPanel(configDir string, logsDir string, dataDir string) {
	<div class="max-w-lg space-y-6 p-6">
		<div class="rounded-lg p-5 space-y-4" style="background:var(--mass-bg-panel);border:1px solid var(--mass-border)">
			<h3 class="text-sm font-semibold uppercase tracking-wide" style="color:var(--mass-text)">Server</h3>
			<!-- Hidden auto-save trigger for settings -->
			<button
				id="settings-autosave-trigger"
				style="display:none"
				data-on:click="@post('/api/settings')"
			></button>

			<sl-input
				label="Listen Address"
				size="small"
				data-bind="listenAddr"
				placeholder=":3455"
				tooltip="HTTP listen address. Restart required to take effect."
			></sl-input>

			<div class="flex items-end gap-2">
				<sl-input
					class="flex-1"
					label="Data Directory"
					size="small"
					data-bind="dataDir"
					placeholder="Platform default"
					tooltip="Root directory for modules and models."
				></sl-input>
				<sl-button size="small" variant="default" onclick="window.__massBrowseDir('dataDir')">
					<sl-icon slot="prefix" name="folder2-open"></sl-icon>
					Browse
				</sl-button>
			</div>

			<sl-input
				label="Model Idle Timeout"
				size="small"
				data-bind="modelIdleTimeout"
				placeholder="2m"
				help-text="Evict dynamic models after this idle period (e.g. 30s, 2m, 1h). Default: 2m."
			></sl-input>

			<sl-input
				label="Module Idle Timeout"
				size="small"
				data-bind="moduleIdleTimeout"
				placeholder="5s"
				help-text="Stop on-demand modules after this idle period (e.g. 5s, 30s, 1m). Default: 5s."
			></sl-input>

			<sl-select
				label="Log Level"
				size="small"
				data-attr:value="$logLevel"
				data-on:sl-change="$logLevel = evt.target.value"
				help-text="Controls MASS and module log verbosity. Applied immediately."
			>
				<sl-option value="trace">Trace</sl-option>
				<sl-option value="debug">Debug</sl-option>
				<sl-option value="info">Info</sl-option>
				<sl-option value="warn">Warn</sl-option>
				<sl-option value="error">Error</sl-option>
			</sl-select>

			<sl-input
				id="auth-token-input"
				label="Auth Token"
				size="small"
				data-bind="authToken"
				type="password"
				data-on:focus="if (!$authTokenEdited) { $authTokenEdited = true; $authToken = '' }"
				data-on:blur="if ($authTokenEdited && $authToken === '' && $authTokenSet) { $authTokenEdited = false; $authToken = '\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022' }"
				data-on:input="if ($authTokenEdited) $authTokenSet = $authToken.length > 0"
				help-text="Leave empty for no auth (dev mode)."
			>
				<div slot="suffix" style="display:flex;align-items:center;gap:6px;margin-right:var(--sl-input-spacing-small)">
					<sl-icon-button
						data-show="$authTokenEdited && $authToken.length > 0"
						name="eye"
						id="auth-token-eye"
						style="font-size:0.95rem;--sl-spacing-x-small:0.2rem"
						data-on:click="var i=document.getElementById('auth-token-input');if(i.type==='password'){i.type='text';this.name='eye-slash'}else{i.type='password';this.name='eye'}"
					></sl-icon-button>
					<sl-icon-button
						data-show="$authToken.length > 0"
						name="x-circle-fill"
						style="font-size:0.95rem;--sl-spacing-x-small:0.2rem"
						data-on:click="$authTokenEdited = true; $authToken = ''; $authTokenSet = false; @post('/api/settings')"
					></sl-icon-button>
				</div>
			</sl-input>

			<div id="settings-status"></div>
		</div>

		<div class="rounded-lg p-5 space-y-4" style="background:var(--mass-bg-panel);border:1px solid var(--mass-border)">
			<h3 class="text-sm font-semibold uppercase tracking-wide" style="color:var(--mass-text)">TLS / SSL</h3>
			<div class="flex items-center justify-between">
				<div>
					<div class="text-sm font-medium" style="color:var(--mass-text)">Enable TLS</div>
					<div class="text-xs" style="color:var(--mass-text-muted)">Encrypt agent and API communication. Restart required.</div>
				</div>
				<sl-switch
					size="small"
					data-attr:checked="$tlsEnabled"
					data-on:sl-change="$tlsEnabled = evt.target.checked"
				></sl-switch>
			</div>

			<div data-show="$tlsEnabled" class="flex items-end gap-2">
				<sl-input
					class="flex-1"
					label="Certificate PEM"
					size="small"
					data-bind="tlsCertFile"
					placeholder="/path/to/server.pem"
					tooltip="PEM file containing certificate and private key."
					autocomplete="off"
				></sl-input>
				<sl-button size="small" variant="default" onclick="window.__massBrowseFile('tlsCertFile','.pem')">
					<sl-icon slot="prefix" name="folder2-open"></sl-icon>
					Browse
				</sl-button>

				</div>
		</div>

		<div class="rounded-lg p-5 space-y-4" style="background:var(--mass-bg-panel);border:1px solid var(--mass-border)">
			<h3 class="text-sm font-semibold uppercase tracking-wide" style="color:var(--mass-text)">Developer</h3>
			<div class="flex items-center justify-between">
				<div>
					<div class="text-sm font-medium" style="color:var(--mass-text)">Developer Mode</div>
					<div class="text-xs" style="color:var(--mass-text-muted)">Show developer controls for module development</div>
				</div>
				<sl-switch
					size="small"
					data-attr:checked="$devMode"
					data-on:sl-change="$devMode = evt.target.checked"
				></sl-switch>
			</div>
		</div>

		if configDir != "" {
			<div class="text-xs text-neutral-500 space-y-1">
				<div>Configs: <span class="font-mono text-neutral-400">{ configDir }</span></div>
				if logsDir != "" {
					<div>Logs: <span class="font-mono text-neutral-400">{ logsDir }</span></div>
				}
				<div data-show="$dataDir">Data: <span class="font-mono text-neutral-400" data-text="$dataDir"></span></div>
			</div>
		}

		<!-- Directory browser dialog for settings -->
		<sl-dialog id="settings-file-browser" label="Browse Directory" style="--width: 640px; --body-spacing: var(--sl-spacing-small) var(--sl-spacing-large); --footer-spacing: 0;">
			<div id="sfb-path" class="flex items-center gap-1 flex-wrap text-xs mb-2 min-h-[24px]"></div>
			<div id="sfb-entries" class="max-h-[420px] overflow-y-auto space-y-0.5 pb-2 border-b border-neutral-700"></div>
			<sl-button slot="footer" size="small" variant="default" onclick="document.getElementById('settings-file-browser').hide()">Cancel</sl-button>
			<sl-button slot="footer" size="small" variant="primary" id="sfb-select">Select This Folder</sl-button>
		</sl-dialog>

		@templ.Raw(settingsBrowseScript)
	</div>
}

templ welcomeState(empty bool) {
	<div class="flex flex-col items-center justify-center h-64 text-center">
		if empty {
			<h2 class="text-lg font-semibold mb-2">No modules configured</h2>
			<p class="text-neutral-400 text-sm mb-4">Add a module to get started.</p>
		} else {
			<h2 class="text-lg font-semibold mb-2">Select a module</h2>
			<p class="text-neutral-400 text-sm mb-4">Choose a module from the sidebar, or install a new one.</p>
		}
		<sl-button variant="primary" size="small" data-on:click="$addModuleOpen = true">
			<sl-icon slot="prefix" name="plus-lg"></sl-icon>
			Install New Module
		</sl-button>
	</div>
}

templ addModuleDialog() {
	<sl-dialog id="mass-add-module-dialog" label="Install Module" data-attr:open="$addModuleOpen" data-on:sl-hide="if(!$installing){$addModuleOpen = false}" style="--width: 520px; --body-spacing: var(--sl-spacing-small) var(--sl-spacing-large) var(--sl-spacing-small); --footer-spacing: var(--sl-spacing-small) var(--sl-spacing-large);">
		<div class="space-y-4">
			<div id="install-error"></div>
			<div data-show="!$installing">
				<label class="text-sm font-medium text-white">Package File</label>
				<div class="flex items-center gap-2 mt-1">
					<sl-input
						size="small"
						data-bind="packagePath"
						placeholder="/path/to/module.mass"
						required
						class="flex-1"
					></sl-input>
					<sl-button size="small" variant="default" onclick="window.__massBrowse('packagePath', '.mass')">
						<sl-icon slot="prefix" name="folder2-open"></sl-icon>Browse
					</sl-button>
				</div>
			</div>
			<div data-show="$installing" class="flex items-center gap-3 py-4 justify-center">
				<sl-spinner style="font-size: 1.5rem;"></sl-spinner>
				<span class="text-sm text-neutral-400">Installing module…</span>
			</div>
		</div>

		<div slot="footer" class="flex gap-2 justify-end">
			<sl-button size="small" data-on:click="$addModuleOpen = false" data-attr:disabled="$installing">
				Cancel
			</sl-button>
			<sl-button
				variant="primary"
				size="small"
				data-on:click="$installing = true; @post('/api/modules/install')"
				data-attr:disabled="$installing"
			>
				Install
			</sl-button>
		</div>
	</sl-dialog>
}
