package templates

import (
	"fmt"
	"net/url"
	"strings"

	"github.com/chinese-room-solutions/mass-sdk/format"
)


// SchedulerInstanceView is one loaded-model row on the Scheduler tab. One
// row per (worker, model) pair.
//
// Filename is the user-facing model name (path stripped of `#fingerprint`);
// Fingerprint is the gateway-supplied config hash (small monospace subtitle
// + selection key). Source is the caller identity ("app: playground" /
// "direct"), Mode reflects how the load was triggered ("dynamic").
// PoolSize/Active come from the worker heartbeat.
type SchedulerInstanceView struct {
	Key         string // "<workerID>:<modelID>" — selection key
	ModelID     string // full gateway-defined ID (path#fingerprint)
	Filename    string // model name without fingerprint, for the row title
	Fingerprint string // hash component, shown as a small monospace subtitle
	WorkerID    string
	WorkerName  string
	RuntimeName string   // e.g. "llama-cpp" — shown as a small pill
	DeviceIDs   []string // every device this model occupies; >1 means tensor split
	Source      string   // caller identity, e.g. "app: playground", "direct"
	Mode        string   // "dynamic" — gateway-driven loads
	PoolSize    int
	Active      int
	Status      string // "Active" / "Idle" / "Loading"
}

// SchedulerInstanceList renders the list of loaded-model cards.
templ SchedulerInstanceList(instances []SchedulerInstanceView) {
	if len(instances) == 0 {
		<div class="flex flex-col items-center justify-center py-16 text-center">
			<sl-icon name="cpu" style="font-size:2rem;color:var(--sl-color-neutral-500)" class="mb-3"></sl-icon>
			<p class="text-sm" style="color:var(--mass-text-muted)">No models loaded.</p>
			<p class="text-xs mt-1" style="color:var(--mass-text-faint)">Workers report loaded models here as gateways warm them up.</p>
		</div>
	} else {
		<div class="space-y-2">
			for _, inst := range instances {
				@schedulerInstanceRow(inst)
			}
		</div>
	}
}

templ schedulerInstanceRow(inst SchedulerInstanceView) {
	<div
		class="scheduler-row bg-neutral-800/60 rounded-lg border border-neutral-700/50 px-4 py-3 cursor-pointer hover:border-neutral-600/80 transition-colors"
		data-attr:class={ fmt.Sprintf("$selectedSchedulerKey==='%s' ? 'scheduler-row bg-neutral-800/60 rounded-lg border border-blue-500/60 px-4 py-3 cursor-pointer' : 'scheduler-row bg-neutral-800/60 rounded-lg border border-neutral-700/50 px-4 py-3 cursor-pointer hover:border-neutral-600/80 transition-colors'", format.JSEscape(inst.Key)) }
		data-filter-text={ strings.ToLower(inst.Filename + " " + inst.Fingerprint + " " + inst.WorkerName + " " + inst.Source + " " + inst.Mode + " " + inst.Status) }
		data-scheduler-key={ inst.Key }
		data-on:click={ fmt.Sprintf("$selectedSchedulerKey='%s'", format.JSEscape(inst.Key)) }
	>
		<!-- Top row: status dot + filename + evict -->
		<div class="flex items-center gap-3">
			<sl-tooltip content={ inst.Status }>
				<span class={ "w-2 h-2 rounded-full flex-shrink-0 " + instanceDotColor(inst.Status) }></span>
			</sl-tooltip>
			<span class="text-sm font-medium text-blue-400 hover:text-blue-300 truncate" title={ inst.Filename }>{ inst.Filename }</span>
			<div class="flex-1"></div>
			if inst.Status != "Loading" {
				<div onclick="event.stopPropagation()">
					<sl-tooltip content="Evict model">
						<sl-icon-button
							name="x-circle"
							style="font-size:0.95rem;color:var(--mass-danger)"
							data-on:click={ fmt.Sprintf("@post('/api/scheduler/evict?worker=%s&model=%s')", url.QueryEscape(inst.WorkerID), url.QueryEscape(inst.ModelID)) }
						></sl-icon-button>
					</sl-tooltip>
				</div>
			}
		</div>
		<!-- Bottom row: fingerprint + meta + badges -->
		<div class="flex items-center gap-4 mt-2 text-xs text-neutral-400 overflow-hidden">
			if inst.Fingerprint != "" {
				<span class="font-mono" title="Config fingerprint">{ inst.Fingerprint }</span>
			}
			if inst.WorkerName != "" {
				<span
					class="text-blue-400 hover:text-blue-300 cursor-pointer"
					title={ "Open in Workers tab: " + inst.WorkerName }
					data-on:click={ fmt.Sprintf("evt.stopPropagation(); window.__massGoToWorker('%s')", format.JSEscape(inst.WorkerID)) }
				>
					<sl-icon name="pc-display" style="font-size:0.75rem;vertical-align:-1px;margin-right:2px"></sl-icon>
					{ inst.WorkerName }
				</span>
			}
			if len(inst.DeviceIDs) > 0 {
				<span class="text-neutral-500" title={ deviceListTitle(inst.DeviceIDs) }>{ strings.Join(inst.DeviceIDs, ", ") }</span>
			}
			if inst.Active > 0 {
				<span>{ fmt.Sprintf("%d active req%s", inst.Active, pluralS(inst.Active)) }</span>
			}
			<span class="ml-auto flex items-center gap-2 flex-shrink-0">
				if inst.Source != "" {
					<span class={ "text-xs rounded px-1.5 py-0.5 " + sourceBadge(inst.Source) }>{ inst.Source }</span>
				}
				if inst.Mode != "" {
					<span class={ "text-xs rounded px-1.5 py-0.5 " + modeBadge(inst.Mode) }>{ inst.Mode }</span>
				}
				<span class={ "text-xs px-2 py-0.5 rounded " + instanceStatusBadge(inst.Status) }>{ inst.Status }</span>
			</span>
		</div>
	</div>
}

// SchedulerInstancePropsView holds the right-pane properties for a row.
// Source, Mode, Filename, Fingerprint mirror SchedulerInstanceView; the
// RuntimeName shown as a small pill. Properties carries any extra
// runtime-specific kv pairs the gateway wants to surface.
type SchedulerInstancePropsView struct {
	Key         string
	ModelID     string
	Filename    string
	Fingerprint string
	WorkerID    string
	WorkerName  string
	RuntimeName string
	DeviceIDs   []string
	Source      string
	Mode        string
	Status      string
	PoolSize    int
	Active      int
	Properties  []PropEntry
}

templ SchedulerInstancePropsPanel(info SchedulerInstancePropsView) {
	<div class="bg-neutral-800/60 rounded-lg border border-neutral-700/50 p-5" style="display:flex;flex-direction:column">
		<div class="flex items-start justify-between mb-4">
			<div class="min-w-0 flex-1">
				<h3 class="text-sm font-semibold text-white break-all">{ info.Filename }</h3>
				if info.Fingerprint != "" {
					<p class="text-xs text-neutral-400 mt-0.5 font-mono break-all">{ info.Fingerprint }</p>
				}
			</div>
			<sl-icon-button name="x-lg" style="font-size:0.85rem" data-on:click="$selectedSchedulerKey=''"></sl-icon-button>
		</div>
		<div class="space-y-2.5">
			@propBadge("Status", info.Status, instanceStatusBadge(info.Status))
			if info.Source != "" {
				@propBadge("Source", info.Source, sourceBadge(info.Source))
			}
			if info.Mode != "" {
				@propBadge("Mode", info.Mode, modeBadge(info.Mode))
			}
			if info.RuntimeName != "" {
				@propBadge("Runtime", info.RuntimeName, runtimeNameBadge(info.RuntimeName))
			}
			if info.WorkerName != "" {
				<div class="flex items-baseline gap-3">
					<span class="text-xs text-neutral-400 flex-shrink-0 whitespace-nowrap" style="min-width:5.5rem">Worker</span>
					<span
						class="text-xs text-blue-400 hover:text-blue-300 cursor-pointer font-mono"
						title={ "Open in Workers tab: " + info.WorkerName }
						data-on:click={ fmt.Sprintf("evt.stopPropagation(); window.__massGoToWorker('%s')", format.JSEscape(info.WorkerID)) }
					>
						<sl-icon name="pc-display" style="font-size:0.7rem;vertical-align:-1px;margin-right:2px"></sl-icon>
						{ info.WorkerName }
					</span>
				</div>
			}
			if len(info.DeviceIDs) > 0 {
				@schedPropRow(deviceLabel(info.DeviceIDs), strings.Join(info.DeviceIDs, ", "))
			}
			if info.Active > 0 {
				@schedPropRow("Active", fmt.Sprintf("%d", info.Active))
			}
			if info.PoolSize > 0 {
				@schedPropRow("Pool Size", fmt.Sprintf("%d", info.PoolSize))
			}
			<div class="flex items-baseline gap-3">
				<span class="text-xs text-neutral-400 flex-shrink-0 whitespace-nowrap" style="min-width:5.5rem">Model</span>
				<span
					class="text-xs text-blue-400 hover:text-blue-300 cursor-pointer font-mono break-all"
					title={ "Open in Models tab: " + info.Filename }
					data-on:click={ fmt.Sprintf("evt.stopPropagation(); window.__massGoToModel('%s')", format.JSEscape(info.ModelID)) }
				>
					<sl-icon name="box" style="font-size:0.7rem;vertical-align:-1px;margin-right:2px"></sl-icon>
					{ info.Filename }
				</span>
			</div>
		</div>
		if len(info.Properties) > 0 {
			<div class="border-t border-neutral-700/50 my-3"></div>
			<div class="space-y-2.5">
				for _, p := range info.Properties {
					@schedPropRow(p.Key, p.Value)
				}
			</div>
		}
		<div class="pt-4 mt-3 border-t border-neutral-700/50 flex items-center justify-center">
			<sl-button
				size="small"
				variant="danger"
				outline
				data-on:click={ fmt.Sprintf("@post('/api/scheduler/evict?worker=%s&model=%s')", url.QueryEscape(info.WorkerID), url.QueryEscape(info.ModelID)) }
			>
				<sl-icon slot="prefix" name="x-circle"></sl-icon>Evict
			</sl-button>
		</div>
	</div>
}

// propBadge is the panel-row variant where the value renders as a colored
// pill (Type / Status / Source / Mode / Runtime). Shares one row with the
// label so the grid doesn't waste vertical space.
templ propBadge(label, value, badgeClass string) {
	<div class="flex items-baseline gap-3">
		<span class="text-xs text-neutral-400 flex-shrink-0 whitespace-nowrap" style="min-width:5.5rem">{ label }</span>
		<span class={ "text-xs rounded px-1.5 py-0.5 " + badgeClass }>{ value }</span>
	</div>
}

// schedPropRow is the scheduler-panel-local variant of [propRow] with a
// narrower label column (5.5rem) so values like "app: playground" fit
// without truncation. Scheduler labels are short ("Device", "Active",
// "Pool Size"); the wider models.templ propRow stays at 8.5rem for that
// tab's long labels.
templ schedPropRow(label, value string) {
	<div class="flex items-baseline gap-3">
		<span class="text-xs text-neutral-400 flex-shrink-0 whitespace-nowrap" style="min-width:5.5rem">{ label }</span>
		<span class="text-xs text-neutral-200 font-mono break-all min-w-0">{ value }</span>
	</div>
}

func instanceDotColor(status string) string {
	switch status {
	case "Active":
		return "bg-green-400"
	case "Loading":
		return "bg-yellow-400 animate-pulse"
	default:
		return "bg-neutral-400"
	}
}

// runtimeNameBadge picks a color for the small runtime-tag pill (e.g.
// "llama-cpp" / "vllm").
func runtimeNameBadge(kind string) string {
	switch strings.ToLower(kind) {
	case "llama-cpp", "llama":
		return "bg-cyan-900/60 text-cyan-300"
	case "vllm":
		return "bg-indigo-900/60 text-indigo-300"
	default:
		return "mass-badge"
	}
}

// sourceBadge highlights gateway-attributed callers ("app: <name>") in teal.
func sourceBadge(source string) string {
	if strings.HasPrefix(source, "app") {
		return "bg-teal-900/60 text-teal-300"
	}
	return "mass-badge"
}

func modeBadge(mode string) string {
	if mode == "dynamic" {
		return "bg-orange-900/60 text-orange-300"
	}
	return "mass-badge"
}

func instanceStatusBadge(status string) string {
	switch status {
	case "Active":
		return "bg-green-900/60 text-green-300"
	case "Loading":
		return "bg-yellow-900/60 text-yellow-300"
	default:
		return "mass-badge"
	}
}

// deviceLabel returns "Device" or "Devices" depending on placement-set size.
func deviceLabel(ids []string) string {
	if len(ids) > 1 {
		return "Devices"
	}
	return "Device"
}

// deviceListTitle is the tooltip for the inline device chip on a scheduler row.
func deviceListTitle(ids []string) string {
	if len(ids) > 1 {
		return fmt.Sprintf("Tensor split across %d devices", len(ids))
	}
	return "Device"
}

// ShortKey returns the last path segment of a model ID for compact display.
func ShortKey(id string) string {
	if i := strings.LastIndexByte(id, '/'); i >= 0 && i < len(id)-1 {
		return id[i+1:]
	}
	return id
}

// Note: cross-tab navigation (worker / model click → switch tab + reveal
// target) is implemented as window.__massGoToWorker / __massGoToModel in
// shell.js. Defining those globally is the only way they survive innerHTML
// replacement of the scheduler list — any <script> tag the server emits
// inside that HTML never runs after the fetch.
